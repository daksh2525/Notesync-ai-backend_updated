# MongoDB Atlas connection string
MONGODB_URI=

# Firebase Admin SDK - service account JSON ka poora content (single line)
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Frontend URL (CORS ke liye)
FRONTEND_URL=http://localhost:5173

# Server port
PORT=5000

# Daily AI credits jo har claim pe milenge
DAILY_CLAIM_AMOUNT=20

# NVIDIA NIM API key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxx

# Model names — .env mein rakhe hain taaki deprecation hone par
# sirf yahan badalna pade, code touch na karna pade
NVIDIA_TEXT_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_EMBED_MODEL=
